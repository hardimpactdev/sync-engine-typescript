{
    "name": "@hardimpactdev/sync-engine",
    "version": "0.1.14",
    "description": "TypeScript client for Sync Engine: a local-first SQLite store with an outbox, a sync client and a scheduler, with optional React hooks. Pairs with the Laravel server, hardimpactdev/sync-engine.",
    "keywords": [
        "sync",
        "local-first",
        "offline",
        "sqlite",
        "laravel",
        "react"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hardimpactdev/sync-engine-typescript.git"
    },
    "homepage": "https://github.com/hardimpactdev/sync-engine-typescript#readme",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.js",
            "default": "./dist/react.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "node scripts/build.mjs",
        "test": "tsx --test tests/*.test.ts",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run typecheck && npm test && npm run build"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
